{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gd-melee.local/character-ir/fx_bindings.schema.json",
  "title": "Geno fighter effect bindings",
  "type": "object",
  "additionalProperties": false,
  "required": ["geno_fx_bindings", "fighter", "host", "unit_scale", "states"],
  "properties": {
    "geno_fx_bindings": {"const": 1},
    "fighter": {"type": "string"},
    "host": {"type": "string"},
    "unit_scale": {"type": "number", "exclusiveMinimum": 0},
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "subaction", "clock", "script", "calls"],
        "properties": {
          "state": {"type": "string"},
          "subaction": {"type": "integer", "minimum": 0},
          "clock": {"enum": ["animation", "game"]},
          "script": {"type": "string"},
          "calls": {"type": "array", "items": {"$ref": "#/$defs/Call"}}
        }
      }
    }
  },
  "$defs": {
    "Vec3": {
      "type": "array", "items": {"type": "number"},
      "minItems": 3, "maxItems": 3
    },
    "Call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame", "macro", "effect", "package", "bone", "joint", "offset",
                   "rotation", "scale", "follow", "when", "end_event"],
      "properties": {
        "frame": {"type": "number", "minimum": 0},
        "macro": {"type": "string"},
        "effect": {"type": "string"},
        "package": {"type": "string", "pattern": "^P_Trail"},
        "bone": {"type": "string"},
        "joint": {"type": "integer", "minimum": 0},
        "offset": {"$ref": "#/$defs/Vec3"},
        "rotation": {"$ref": "#/$defs/Vec3"},
        "scale": {"type": "number"},
        "follow": {"type": "boolean"},
        "situation": {"enum": ["ground", "air"], "description": "optional situation for a state shared by ground and air"},
        "when": {"type": "array", "items": {
          "type": "object", "required": ["test", "holds"],
          "properties": {"test": {"type": "string"}, "holds": {"type": "boolean"}}
        }},
        "end_frame": {"type": "number", "minimum": 0},
        "end_event": {"enum": ["state_exit", "owner_destroy", "emitter_life", "off", "detach"]},
        "source": {"type": "array", "prefixItems": [{"type": "string"}, {"type": "integer", "minimum": 0}],
                   "minItems": 2, "maxItems": 2}
      }
    }
  }
}
