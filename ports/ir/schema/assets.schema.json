{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gd-melee.local/character-ir/assets.schema.json",
  "title": "Character IR - assets",
  "description": "What the character is made of, independent of how it behaves: skeleton, models, materials, textures, costumes, the animation library, effects, audio, UI art and media. Every entity says which file holds it (resources) and keeps bulk data in BlobRefs. Semantic fields are engine-neutral; storage details sit in 'encoding' / 'engine'.",
  "$defs": {
    "Assets": {
      "type": "object",
      "properties": {
        "skeletons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Skeleton"
          }
        },
        "bone_roles": {
          "description": "Semantic names for bones the engine or scripts address by role (Melee: ftPartsTable Fighter_Part ids; Brawl: the bone references in the fighter's attribute/misc data). This is the bridge that lets two engines' skeletons be compared.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/BoneRole"
          }
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Model"
          }
        },
        "materials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Material"
          }
        },
        "textures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Texture"
          }
        },
        "material_animations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MaterialAnimation"
          }
        },
        "part_visibility": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PartVisibilityTable"
          }
        },
        "costumes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Costume"
          }
        },
        "animations": {
          "$ref": "#/$defs/AnimationLibrary"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EffectBank"
          }
        },
        "audio": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SoundBank"
          }
        },
        "ui": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UiAsset"
          }
        },
        "media": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Media"
          }
        },
        "collectibles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Collectible"
          }
        },
        "costume_sets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CostumeSet"
          }
        }
      },
      "additionalProperties": false
    },
    "Skeleton": {
      "type": "object",
      "required": [
        "id",
        "joints"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "name": {
          "type": "string"
        },
        "file": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "symbol": {
          "type": "string"
        },
        "joint_count": {
          "type": "integer",
          "minimum": 1
        },
        "order": {
          "enum": [
            "depth_first",
            "breadth_first",
            "file_order"
          ],
          "description": "The order joint indices follow; animations and parts tables index in this order."
        },
        "joints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Joint"
          }
        },
        "same_as": {
          "description": "Other skeletons with identical topology/rest pose (e.g. Shadow's = ACE Sonic's), and how they differ.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "skeleton"
            ],
            "properties": {
              "skeleton": {
                "$ref": "common.schema.json#/$defs/Ref"
              },
              "topology": {
                "type": "boolean"
              },
              "rest_pose": {
                "type": "boolean"
              },
              "differences": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/Provenance"
        },
        "engine": {
          "$ref": "common.schema.json#/$defs/EngineExtensions"
        },
        "derived_from": {
          "type": "string",
          "description": "The skeleton this one was edited from (e.g. vBrawl Sonic's, with quill bones changed)."
        },
        "rest_pose_variants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "used_by": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "topology_signature": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Joint": {
      "type": "object",
      "required": [
        "index"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Null when the format stores no names (Melee costumes): the index is then the only identity."
        },
        "parent": {
          "type": [
            "integer",
            "null"
          ]
        },
        "rest": {
          "type": "object",
          "properties": {
            "translation": {
              "$ref": "common.schema.json#/$defs/Vec3"
            },
            "rotation_euler_rad": {
              "$ref": "common.schema.json#/$defs/Vec3"
            },
            "scale": {
              "$ref": "common.schema.json#/$defs/Vec3"
            }
          },
          "additionalProperties": false
        },
        "inverse_bind": {
          "$ref": "common.schema.json#/$defs/Matrix3x4"
        },
        "traits": {
          "description": "Semantic joint flags.",
          "type": "array",
          "items": {
            "enum": [
              "skeleton_root",
              "skinned_bone",
              "has_inverse_bind",
              "envelope_model",
              "classical_scale",
              "billboard",
              "lighting",
              "specular",
              "hidden",
              "effector",
              "ik_chain",
              "physics",
              "opaque_pass",
              "translucent_pass",
              "texture_edge_pass",
              "visibility_gate",
              "quill",
              "item_hold",
              "throw_anchor"
            ]
          }
        },
        "raw_flags": {
          "$ref": "common.schema.json#/$defs/Hex"
        },
        "role_guess": {
          "type": "string",
          "description": "Inferred anatomical role when there is no name (e.g. 'right hand, finger 2'), with confidence in provenance."
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/Provenance"
        }
      },
      "additionalProperties": false
    },
    "BoneRole": {
      "type": "object",
      "required": [
        "role",
        "joint"
      ],
      "properties": {
        "role": {
          "description": "Canonical role. Engine-neutral names: root, trans_n, hip, waist, spine, chest, neck, head, jaw, eye_l/r, shoulder_l/r, arm_l/r, elbow_l/r, hand_l/r, hand_item_l/r, thumb_l/r, finger_*_l/r, leg_l/r, knee_l/r, foot_l/r, toe_l/r, tail_*, throw_position, throw_n, hat_attach, top_n, effect_*.",
          "type": "string"
        },
        "joint": {
          "type": "integer",
          "minimum": 0
        },
        "skeleton": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "engine_index": {
          "$ref": "common.schema.json#/$defs/IndexSpace",
          "description": "The engine's own id for the role (Melee Fighter_Part n)."
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/Provenance"
        }
      },
      "additionalProperties": false
    },
    "Model": {
      "type": "object",
      "required": [
        "id",
        "skeleton",
        "meshes"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "name": {
          "type": "string"
        },
        "skeleton": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "shared_by_costumes": {
          "type": "boolean",
          "description": "True when every costume uses this geometry and only swaps textures."
        },
        "meshes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Mesh"
          }
        },
        "vertex_buffers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/Id"
              },
              "attribute": {
                "enum": [
                  "position",
                  "normal",
                  "binormal",
                  "tangent",
                  "color0",
                  "color1",
                  "uv0",
                  "uv1",
                  "uv2",
                  "uv3",
                  "matrix_index"
                ]
              },
              "count": {
                "type": "integer"
              },
              "encoding": {
                "$ref": "common.schema.json#/$defs/Encoding"
              },
              "data": {
                "$ref": "common.schema.json#/$defs/BlobRef"
              }
            },
            "additionalProperties": false
          }
        },
        "stats": {
          "type": "object",
          "properties": {
            "meshes": {
              "type": "integer"
            },
            "primitive_groups": {
              "type": "integer"
            },
            "display_list_bytes": {
              "type": "integer"
            },
            "unique_images": {
              "type": "integer"
            }
          },
          "additionalProperties": {
            "type": "integer"
          }
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/Provenance"
        },
        "engine": {
          "$ref": "common.schema.json#/$defs/EngineExtensions"
        },
        "role": {
          "enum": [
            "body",
            "drop_shadow",
            "kirby_hat",
            "copy_projectile",
            "final_smash_form",
            "effect",
            "trophy",
            "other"
          ]
        }
      },
      "additionalProperties": false
    },
    "Mesh": {
      "description": "One drawable unit (Melee DObj; Brawl MDL0 object). 'index' is the stable order that visibility tables address - reordering meshes breaks those tables.",
      "type": "object",
      "required": [
        "index"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "attached_joint": {
          "type": "integer"
        },
        "material": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "primitive_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "skinning": {
                "enum": [
                  "rigid",
                  "envelope",
                  "single_bind",
                  "shape_blend"
                ]
              },
              "max_influences": {
                "type": "integer",
                "minimum": 0
              },
              "attributes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "attribute"
                  ],
                  "properties": {
                    "attribute": {
                      "type": "string"
                    },
                    "index_format": {
                      "enum": [
                        "direct",
                        "index8",
                        "index16"
                      ]
                    },
                    "components": {
                      "type": "integer"
                    },
                    "encoding": {
                      "$ref": "common.schema.json#/$defs/Encoding"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "influence_histogram": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              },
              "display_list": {
                "$ref": "common.schema.json#/$defs/BlobRef"
              }
            },
            "additionalProperties": false
          }
        },
        "lod": {
          "enum": [
            "high",
            "low",
            "any"
          ],
          "description": "Filled from part_visibility when the mesh belongs to one detail level."
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/Provenance"
        },
        "engine": {
          "$ref": "common.schema.json#/$defs/EngineExtensions"
        },
        "draws": {
          "description": "Material draw calls of this mesh, each gated by a visibility bone (Brawl MDL0 objects draw several materials, each shown/hidden by a bone's visibility).",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "material": {
                "type": "string"
              },
              "visibility_bone": {
                "type": "string"
              },
              "pass": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "single_bind": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "vertices": {
          "type": "integer"
        },
        "faces": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "Material": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "shading": {
          "type": "object",
          "properties": {
            "lighting": {
              "enum": [
                "none",
                "diffuse",
                "diffuse_specular",
                "unknown"
              ]
            },
            "alpha": {
              "enum": [
                "opaque",
                "cutout",
                "blend",
                "unknown"
              ]
            },
            "cull": {
              "enum": [
                "none",
                "back",
                "front",
                "both",
                "unknown"
              ]
            },
            "raw_render_mode": {
              "$ref": "common.schema.json#/$defs/Hex"
            }
          },
          "additionalProperties": false
        },
        "colors": {
          "type": "object",
          "properties": {
            "ambient": {
              "$ref": "common.schema.json#/$defs/ColorRGBA"
            },
            "diffuse": {
              "$ref": "common.schema.json#/$defs/ColorRGBA"
            },
            "specular": {
              "$ref": "common.schema.json#/$defs/ColorRGBA"
            },
            "shininess": {
              "type": "number"
            },
            "alpha": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "layers": {
          "description": "Texture stages in order.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "texture_slot": {
                "type": "string",
                "description": "A costume-overridable slot name; costumes map slots to textures."
              },
              "default_texture": {
                "$ref": "common.schema.json#/$defs/Ref"
              },
              "coord_source": {
                "type": "string"
              },
              "wrap": {
                "type": "array",
                "items": {
                  "enum": [
                    "clamp",
                    "repeat",
                    "mirror"
                  ]
                }
              },
              "blend": {
                "type": "string"
              },
              "raw_flags": {
                "$ref": "common.schema.json#/$defs/Hex"
              }
            },
            "additionalProperties": false
          }
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/Provenance"
        },
        "engine": {
          "$ref": "common.schema.json#/$defs/EngineExtensions"
        },
        "variant_of": {
          "type": "string"
        },
        "variant_role": {
          "enum": [
            "metal",
            "team",
            "other"
          ]
        }
      },
      "additionalProperties": false
    },
    "Texture": {
      "type": "object",
      "required": [
        "id",
        "width",
        "height",
        "format"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "enum": [
            "I4",
            "I8",
            "IA4",
            "IA8",
            "RGB565",
            "RGB5A3",
            "RGBA8",
            "CI4",
            "CI8",
            "CI14X2",
            "CMPR"
          ]
        },
        "palette": {
          "type": "object",
          "properties": {
            "format": {
              "enum": [
                "IA8",
                "RGB565",
                "RGB5A3"
              ]
            },
            "entries": {
              "type": "integer"
            },
            "count": {
              "type": "integer",
              "description": "Number of alternate palettes (animated/expression swaps)."
            }
          },
          "additionalProperties": false
        },
        "mipmaps": {
          "type": "integer",
          "minimum": 0
        },
        "pixels": {
          "$ref": "common.schema.json#/$defs/BlobRef"
        },
        "content_hash": {
          "type": "string",
          "description": "Hash of the decoded pixels; lets costumes be compared semantically even when files store buffers in different orders."
        },
        "semantic": {
          "type": "string",
          "description": "What it depicts: 'body', 'eyes', 'quills', 'shoes', 'face', ..."
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/Provenance"
        }
      },
      "additionalProperties": false
    },
    "MaterialAnimation": {
      "description": "Texture/colour animation bound to meshes (Melee MatAnimJoint + TexAnim; Brawl SRT0/PAT0/CLR0). 'driver' says what advances it: its own clock, the current animation, or fighter code (e.g. blinking eyes).",
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Mesh indices."
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "texture_swap",
                  "palette_swap",
                  "uv_translate",
                  "uv_rotate",
                  "uv_scale",
                  "color",
                  "alpha"
                ]
              },
              "frames": {
                "type": "integer"
              },
              "images": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/Ref"
                }
              },
              "palettes": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          }
        },
        "driver": {
          "enum": [
            "clock",
            "animation",
            "fighter_code",
            "script",
            "unknown"
          ]
        },
        "purpose": {
          "type": "string",
          "description": "e.g. 'eye expressions', 'blink', 'charge glow'."
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/Provenance"
        },
        "engine": {
          "$ref": "common.schema.json#/$defs/EngineExtensions"
        }
      },
      "additionalProperties": false
    },
    "PartVisibilityTable": {
      "description": "Mesh show/hide sets per model part and state (Melee: ftData model-part lookups; Brawl: bone visibility / 'model changer' toggles in PSA). Lets scripts/code say 'hand part -> state 2' without naming meshes.",
      "type": "object",
      "required": [
        "id",
        "parts"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "row": {
          "type": "integer",
          "description": "The variant row costumes select (Melee costume_file.vis_idx)."
        },
        "column": {
          "enum": [
            "high_detail",
            "low_detail",
            "metal",
            "conditional",
            "default"
          ]
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "part"
            ],
            "properties": {
              "part": {
                "type": "integer"
              },
              "semantic": {
                "type": "string",
                "description": "body, hand_l, hand_r, eyes, mouth, ..."
              },
              "states": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "integer"
                    },
                    "meshes": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "semantic": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "gate_bone": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "hazards": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "e.g. 'rows 5-6 would read unrelated data'."
        },
        "provenance": {
          "$ref": "common.schema.json#/$defs/Provenance"
        },
        "driver": {
          "enum": [
            "table_lookup",
            "visibility_bones",
            "script",
            "code"
          ],
          "description": "Melee: a table of mesh index sets looked up by part/state; Brawl: bones whose visibility gates draw calls, toggled by animations/scripts."
        }
      },
      "additionalProperties": false
    },
    "Costume": {
      "type": "object",
      "required": [
        "id",
        "index"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "index": {
          "$ref": "common.schema.json#/$defs/IndexSpace"
        },
        "name": {
          "type": "string",
          "description": "Colour name ('Nr', 'Blue', 'Red'...)."
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Ref"
          }
        },
        "model": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "kind": {
          "description": "texture_swap: same geometry/skeleton/materials, other images. palette_swap: same images, other palettes. model_swap: different geometry.",
          "enum": [
            "base",
            "texture_swap",
            "palette_swap",
            "model_swap",
            "mixed"
          ]
        },
        "texture_overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slot": {
                "type": "string"
              },
              "texture": {
                "$ref": "common.schema.json#/$defs/Ref"
              },
              "meshes_affected": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          }
        },
        "material_animation": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "visibility_row": {
