hitbox slot=2 joint=@UPARM_L@ damage=2 size=2.836 x=1.197 y=-0.09093 z=0.0736 angle=361 kbg=60 fkb=10 bkb=0
wait_until 5
jab_combo disabled=0
jab_rapid state=1
wait_until 6
clear_hitboxes
wait_until 18
iasa
