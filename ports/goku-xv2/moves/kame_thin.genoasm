# Kamehameha Thin beam (tier 1, "ka"). Generated by tools/gen_kame.py (numbers: KAMEHAMEHA.md). Destination design, no source script.
# Beam = four spheres along the hands, built out over 3 clip frames, re-hitting every 5 frames; the beam effect is fx P_TrailGokuKameThin.
PUT ANIM_RATE 1.0
clear_hitboxes
wait_until 6
sfx behavior=1 sfx_id=200115 volume=127 panning=64
sfx behavior=1 sfx_id=200118 volume=127 panning=64
PUT ANIM_RATE 0.5
hitbox slot=0 joint=@HAND_R@ damage=1.1 size=2.4 x=-2.04 y=-0.55 z=3.96 angle=361 kbg=60 fkb=7 bkb=0 element=2 shield=0
REHIT 15 5
HBSTUN 15 5
HBFLAGS 15 1
wait 1
hitbox slot=1 joint=@HAND_R@ damage=1.1 size=2.4 x=-4.54 y=-1.22 z=8.81 angle=361 kbg=60 fkb=7 bkb=0 element=2 shield=0
wait 1
hitbox slot=2 joint=@HAND_R@ damage=1.1 size=2.4 x=-7.04 y=-1.89 z=13.66 angle=361 kbg=60 fkb=7 bkb=0 element=2 shield=0
wait 1
hitbox slot=3 joint=@HAND_R@ damage=1.1 size=2.4 x=-9.53 y=-2.56 z=18.50 angle=361 kbg=60 fkb=7 bkb=0 element=2 shield=0
wait_until 16
HBFLAGS 15 0
clear_hitboxes
hitbox slot=0 joint=@HAND_R@ damage=3 size=2.8 x=-4.31 y=-1.16 z=8.37 angle=55 kbg=50 fkb=0 bkb=25 element=2 shield=0
hitbox slot=1 joint=@HAND_R@ damage=3 size=2.8 x=-6.81 y=-1.83 z=13.21 angle=55 kbg=50 fkb=0 bkb=25 element=2 shield=0
hitbox slot=2 joint=@HAND_R@ damage=3 size=2.8 x=-9.31 y=-2.50 z=18.06 angle=55 kbg=50 fkb=0 bkb=25 element=2 shield=0
hitbox slot=3 joint=@HAND_R@ damage=3 size=2.8 x=-11.80 y=-3.17 z=22.91 angle=55 kbg=50 fkb=0 bkb=25 element=2 shield=0
wait 3
REHIT 15 0
clear_hitboxes
PUT ANIM_RATE 1.0
wait_until 36
iasa
