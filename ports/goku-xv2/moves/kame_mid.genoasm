# Kamehameha Mid beam (charge 15-44). Generated by tools/gen_kame.py (numbers: KAMEHAMEHA.md). Destination design, no source script.
# Beam = four spheres along the hands, built out over 3 clip frames, re-hitting every 5 frames; the beam effect is fx P_TrailGokuKameMid.
PUT ANIM_RATE 1.0
clear_hitboxes
wait_until 6
sfx behavior=1 sfx_id=200115 volume=127 panning=64
sfx behavior=1 sfx_id=200118 volume=127 panning=64
PUT ANIM_RATE 0.45
hitbox slot=0 joint=@HAND_R@ damage=1 size=3.2 x=-2.50 y=-0.67 z=4.85 angle=361 kbg=60 fkb=8 bkb=0 element=2 shield=0
REHIT 15 5
HBSTUN 15 6
HBFLAGS 15 1
wait 1
hitbox slot=1 joint=@HAND_R@ damage=1 size=3.2 x=-5.45 y=-1.46 z=10.57 angle=361 kbg=60 fkb=8 bkb=0 element=2 shield=0
wait 1
hitbox slot=2 joint=@HAND_R@ damage=1 size=3.2 x=-8.40 y=-2.26 z=16.30 angle=361 kbg=60 fkb=8 bkb=0 element=2 shield=0
wait 1
hitbox slot=3 joint=@HAND_R@ damage=1 size=3.2 x=-11.35 y=-3.05 z=22.02 angle=361 kbg=60 fkb=8 bkb=0 element=2 shield=0
wait_until 19
HBFLAGS 15 0
clear_hitboxes
hitbox slot=0 joint=@HAND_R@ damage=4 size=3.6 x=-4.77 y=-1.28 z=9.25 angle=45 kbg=80 fkb=0 bkb=35 element=2 shield=0
hitbox slot=1 joint=@HAND_R@ damage=4 size=3.6 x=-7.72 y=-2.07 z=14.98 angle=45 kbg=80 fkb=0 bkb=35 element=2 shield=0
hitbox slot=2 joint=@HAND_R@ damage=4 size=3.6 x=-10.67 y=-2.87 z=20.70 angle=45 kbg=80 fkb=0 bkb=35 element=2 shield=0
hitbox slot=3 joint=@HAND_R@ damage=4 size=3.6 x=-13.62 y=-3.66 z=26.43 angle=45 kbg=80 fkb=0 bkb=35 element=2 shield=0
wait 3
REHIT 15 0
clear_hitboxes
PUT ANIM_RATE 1.0
wait_until 45
iasa
