# Kamehameha Mid beam (charge 15-44). Generated by tools/gen_kame.py (numbers: KAMEHAMEHA.md). Destination design, no source script.
# Beam = four spheres along the hands, built out over 3 clip frames, re-hitting every 5 frames; the beam effect is fx P_TrailGokuKameMid.
PUT ANIM_RATE 1.0
clear_hitboxes
wait_until 6
sfx behavior=1 sfx_id=164 volume=127 panning=64
PUT ANIM_RATE 0.45
hitbox slot=0 joint=@HAND_R@ damage=1.2 size=3.2 x=-2.50 y=-0.67 z=4.85 angle=361 kbg=0 fkb=12 bkb=0 element=2 shield=0
REHIT 15 5
HBSTUN 15 6
HBFLAGS 15 1
wait 1
hitbox slot=1 joint=@HAND_R@ damage=1.2 size=3.2 x=-5.45 y=-1.46 z=10.57 angle=361 kbg=0 fkb=12 bkb=0 element=2 shield=0
wait 1
hitbox slot=2 joint=@HAND_R@ damage=1.2 size=3.2 x=-8.40 y=-2.26 z=16.30 angle=361 kbg=0 fkb=12 bkb=0 element=2 shield=0
wait 1
hitbox slot=3 joint=@HAND_R@ damage=1.2 size=3.2 x=-11.35 y=-3.05 z=22.02 angle=361 kbg=0 fkb=12 bkb=0 element=2 shield=0
wait_until 19
REHIT 15 0
HBFLAGS 15 0
clear_hitboxes
PUT ANIM_RATE 1.0
hitbox slot=0 joint=@HAND_R@ damage=5 size=3.6 x=-2.50 y=-0.67 z=4.85 angle=45 kbg=80 fkb=0 bkb=35 element=2 shield=0
hitbox slot=1 joint=@HAND_R@ damage=5 size=3.6 x=-5.45 y=-1.46 z=10.57 angle=45 kbg=80 fkb=0 bkb=35 element=2 shield=0
hitbox slot=2 joint=@HAND_R@ damage=5 size=3.6 x=-8.40 y=-2.26 z=16.30 angle=45 kbg=80 fkb=0 bkb=35 element=2 shield=0
hitbox slot=3 joint=@HAND_R@ damage=5 size=3.6 x=-11.35 y=-3.05 z=22.02 angle=45 kbg=80 fkb=0 bkb=35 element=2 shield=0
wait 3
clear_hitboxes
wait_until 45
iasa
