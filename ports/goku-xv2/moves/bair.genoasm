# HB-SAMPLE (remake phase 2): carried unchanged from the earlier hand-authored cross-port bair spheres (owner: looks and works as intended).
# bair: cross-port back aerial, owner choice (2026-10-09): no suitable XV2 back attack. Hand-authored parametric hitboxes on the lower and upper leg.
# Sizes and offsets are in script units (build.py multiplies by the model scale). Damage 11, angle 361, KBG 100, BKB 12, hitboxes f6-18, IASA f29.
PUT ANIM_RATE 1.0
wait_until 6
cmd_var w0.idx=0 w0.value=1
hitbox slot=0 joint=@LEG_R@ damage=11 size=4.23828125 x=-0.01171875 y=-3.46875 z=-0.01953125 angle=361 kbg=100 fkb=0 bkb=12 item_hit=1 clank=1 rebound=1 sfx_kind=2
hitbox slot=1 joint=@UPLEG_R@ damage=11 size=5.6484375 x=0 y=-2.13671875 z=0 angle=361 kbg=100 fkb=0 bkb=12 item_hit=1 clank=1 rebound=1 sfx_kind=2
sfx w0.behavior=1 w0.unknown=0 w1.sfx_id=165 w2.padding=0 w2.volume=127 w2.panning=64
rumble w0.unk1=0 w0.unk2=16 w0.unk3=0
wait_until 18
hitboxes_clear
wait_until 19
cmd_var w0.idx=0 w0.value=0
wait_until 29
iasa
