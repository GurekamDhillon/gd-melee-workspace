sfx w0.behavior=1 w0.unknown=0 w1.sfx_id=165 w2.padding=0 w2.volume=127 w2.panning=64
rumble w0.unk1=0 w0.unk2=16 w0.unk3=0
wait_until 18
wait_until 19
cmd_var w0.idx=0 w0.value=0
wait_until 29
iasa
