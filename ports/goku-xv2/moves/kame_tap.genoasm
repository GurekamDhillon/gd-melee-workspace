hitbox slot=0 joint=@HAND_R@ damage=1 size=2 x=-1.82 y=-0.49 z=3.52 angle=361 kbg=60 fkb=8 bkb=0 element=2 shield=0
REHIT 15 5
HBSTUN 15 4
