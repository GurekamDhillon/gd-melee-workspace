# Kamehameha Tap beam (charge < 15 frames). Generated by tools/gen_kame.py (numbers: KAMEHAMEHA.md). Destination design, no source script.
# Beam = four spheres along the hands, built out over 3 clip frames, re-hitting every 5 frames; the beam effect is fx P_TrailGokuKameTap.
PUT ANIM_RATE 1.0
clear_hitboxes
wait_until 5
sfx behavior=1 sfx_id=164 volume=127 panning=64
PUT ANIM_RATE 0.5
hitbox slot=0 joint=@HAND_R@ damage=1.2 size=2.4 x=-1.82 y=-0.49 z=3.52 angle=361 kbg=0 fkb=10 bkb=0 element=2 shield=0
REHIT 15 5
HBSTUN 15 5
HBFLAGS 15 1
wait 1
hitbox slot=1 joint=@HAND_R@ damage=1.2 size=2.4 x=-4.31 y=-1.16 z=8.37 angle=361 kbg=0 fkb=10 bkb=0 element=2 shield=0
wait 1
hitbox slot=2 joint=@HAND_R@ damage=1.2 size=2.4 x=-6.81 y=-1.83 z=13.21 angle=361 kbg=0 fkb=10 bkb=0 element=2 shield=0
wait 1
hitbox slot=3 joint=@HAND_R@ damage=1.2 size=2.4 x=-9.31 y=-2.50 z=18.06 angle=361 kbg=0 fkb=10 bkb=0 element=2 shield=0
wait_until 12
REHIT 15 0
HBFLAGS 15 0
clear_hitboxes
PUT ANIM_RATE 1.0
hitbox slot=0 joint=@HAND_R@ damage=3 size=2.8 x=-1.82 y=-0.49 z=3.52 angle=50 kbg=60 fkb=0 bkb=25 element=2 shield=0
hitbox slot=1 joint=@HAND_R@ damage=3 size=2.8 x=-4.31 y=-1.16 z=8.37 angle=50 kbg=60 fkb=0 bkb=25 element=2 shield=0
hitbox slot=2 joint=@HAND_R@ damage=3 size=2.8 x=-6.81 y=-1.83 z=13.21 angle=50 kbg=60 fkb=0 bkb=25 element=2 shield=0
hitbox slot=3 joint=@HAND_R@ damage=3 size=2.8 x=-9.31 y=-2.50 z=18.06 angle=50 kbg=60 fkb=0 bkb=25 element=2 shield=0
wait 3
clear_hitboxes
wait_until 30
iasa
