# HB-SAMPLE (remake phase 2, 2026-10-11): a generated STARTING POINT, not an authored hitbox. Spheres ride the leading limb chain (tip, middle, inner),
# sized from the mesh; timing, damage and reaction are derived from the XV2 hit entry (tools/remake_samples.py, REMAKE-SAMPLES.md). Edit it in the Workbench.
# XV2 hit entry 343; limb hand.R
# SOURCE: Mario AttackAirF (retail): 2 spheres, 5 frames, damage 15, angle 280, KBG 70, BKB 30, no sourspot
PUT ANIM_RATE 1.0
wait_until 7
cmd_var idx=0 value=1
wait_until 8
sfx behavior=1 sfx_id=165 volume=127 panning=64
wait_until 15
hitbox slot=0 joint=@ARM_R@ damage=15 size=2.8 x=-2.802 y=-0.0331 z=0.04988 angle=280 kbg=70 fkb=0 bkb=30
hitbox slot=1 joint=@ARM_R@ damage=15 size=2.8 x=-1.492 y=-0.05802 z=0.01413 angle=280 kbg=70 fkb=0 bkb=30
wait_until 20
clear_hitboxes
wait_until 26
cmd_var idx=0 value=0
wait_until 40
iasa
