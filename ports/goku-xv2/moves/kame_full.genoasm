# Kamehameha Full beam (charge 45-60). Generated by tools/gen_kame.py (numbers: KAMEHAMEHA.md). Destination design, no source script.
# Beam = four spheres along the hands, built out over 3 clip frames, re-hitting every 5 frames; the beam effect is fx P_TrailGokuKameFull.
PUT ANIM_RATE 1.0
clear_hitboxes
wait_until 8
sfx behavior=1 sfx_id=164 volume=127 panning=64
PUT ANIM_RATE 0.4
hitbox slot=0 joint=@HAND_R@ damage=1.5 size=4.2 x=-3.18 y=-0.85 z=6.17 angle=361 kbg=0 fkb=14 bkb=0 element=2 shield=0
REHIT 15 5
HBSTUN 15 6
HBFLAGS 15 1
wait 1
hitbox slot=1 joint=@HAND_R@ damage=1.5 size=4.2 x=-7.04 y=-1.89 z=13.66 angle=361 kbg=0 fkb=14 bkb=0 element=2 shield=0
wait 1
hitbox slot=2 joint=@HAND_R@ damage=1.5 size=4.2 x=-10.90 y=-2.93 z=21.14 angle=361 kbg=0 fkb=14 bkb=0 element=2 shield=0
wait 1
