# HB-SAMPLE (remake phase 2, 2026-10-11): a generated STARTING POINT, not an authored hitbox. Spheres ride the leading limb chain (tip, middle, inner),
# sized from the mesh; timing, damage and reaction are derived from the XV2 hit entry (tools/remake_samples.py, REMAKE-SAMPLES.md). Edit it in the Workbench.
# XV2 hit entry 302; limb foot.L
# SOURCE: spike sweetspot 2.1 script units (3.6 in game) for 3 frames, sourspot elsewhere; Marth dair tipper 3.5 / 4 frames / 290 / KBG 70 / BKB 40 is the reference
PUT ANIM_RATE 1.0
wait_until 4
cmd_var idx=0 value=1
sfx behavior=1 sfx_id=164 volume=127 panning=64
wait_until 10
hitbox slot=1 joint=@LEG_L@ damage=6 size=4.91 x=0.07586 y=-1.697 z=-0.04726 angle=40 kbg=70 fkb=0 bkb=20
hitbox slot=2 joint=@UPLEG_L@ damage=6 size=5.04 x=0.1067 y=-1.503 z=-0.002655 angle=40 kbg=70 fkb=0 bkb=20
wait_until 11
hitbox slot=0 joint=@FOOT_L@ damage=8 size=2.1 x=0.0391 y=-0.406 z=0.8485 angle=290 kbg=70 fkb=0 bkb=40
wait_until 14
clear_hitbox hit_idx=0
hitbox slot=3 joint=@FOOT_L@ damage=6 size=2.8 x=0.0391 y=-0.406 z=0.8485 angle=40 kbg=70 fkb=0 bkb=20
wait_until 17
clear_hitboxes
wait_until 26
cmd_var idx=0 value=0
wait_until 36
iasa
