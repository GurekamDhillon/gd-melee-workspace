# Kamehameha charge (generated by tools/gen_kame.py: numbers in KAMEHAMEHA.md section 0c). B once, then it charges by itself (lua/goku.lua; the native model).
# Full is CHARGE_FRAMES (600) after the Start phase: the chant "ka-me-ha-me" (XV2 VOX cue 0, four syllables) at state frames 55, 175, 355, 535, the hum (XV2 SE cue 0 resampled up in
# four steps) loops under it, louder and higher between the beats. The "HA!" (cue 1) plays on release (the beam scripts). The script clock is CLIP frames: the pose
# is reached by frame 20 and the clip is then stretched (ANIM_RATE 0.114) so it does not end and restart the script. No damaging hitbox.
PUT ANIM_RATE 1.0
clear_hitboxes
wait_until 1
sfx behavior=1 sfx_id=200100 volume=70 panning=64
wait_until 20
PUT ANIM_RATE 0.114
wait_until 24
sfx behavior=1 sfx_id=200121 volume=127 panning=64
wait_until 32
sfx behavior=1 sfx_id=200100 volume=76 panning=64
wait_until 38
sfx behavior=1 sfx_id=200124 volume=127 panning=64
sfx behavior=1 sfx_id=200133 volume=84 panning=64
wait_until 51
sfx behavior=1 sfx_id=200133 volume=92 panning=64
wait_until 58
sfx behavior=1 sfx_id=200127 volume=127 panning=64
wait_until 59
sfx behavior=1 sfx_id=200136 volume=100 panning=64
wait_until 70
sfx behavior=1 sfx_id=200136 volume=108 panning=64
wait_until 79
sfx behavior=1 sfx_id=200130 volume=127 panning=64
sfx behavior=1 sfx_id=200139 volume=118 panning=64
wait_until 89
sfx behavior=1 sfx_id=200139 volume=127 panning=64
wait_until 98
sfx behavior=1 sfx_id=200139 volume=127 panning=64
wait_until 134
