# HB-SAMPLE (remake phase 2, 2026-10-11): a generated STARTING POINT, not an authored hitbox. Spheres ride the leading limb chain (tip, middle, inner),
# sized from the mesh; timing, damage and reaction are derived from the XV2 hit entry (tools/remake_samples.py, REMAKE-SAMPLES.md). Edit it in the Workbench.
# XV2 hit entry 302; limb foot.L
PUT ANIM_RATE 1.0
wait_until 2
GET ra_f:0 FACING
MUL ra_f:0 1.2
PUT GROUND_VEL ra_f:0
wait_until 7
GET ra_f:0 FACING
MUL ra_f:0 1.2
PUT GROUND_VEL ra_f:0
wait_until 10
hitbox slot=0 joint=@FOOT_L@ damage=7 size=2.8 x=0.0391 y=-0.406 z=0.8485 angle=361 kbg=60 fkb=10 bkb=0
hitbox slot=1 joint=@LEG_L@ damage=6 size=4.91 x=0.07586 y=-1.697 z=-0.04726 angle=361 kbg=60 fkb=10 bkb=0
hitbox slot=2 joint=@UPLEG_L@ damage=5 size=5.04 x=0.1067 y=-1.503 z=-0.002655 angle=361 kbg=60 fkb=10 bkb=0
HBSTUN 7 15
wait_until 12
GET ra_f:0 FACING
MUL ra_f:0 1.2
PUT GROUND_VEL ra_f:0
wait_until 14
clear_hitboxes
wait_until 16
PUT GROUND_VEL 0
wait_until 35
iasa
