# HB-SAMPLE (remake phase 2, 2026-10-11): a generated STARTING POINT, not an authored hitbox. Spheres ride the leading limb chain (tip, middle, inner),
# sized from the mesh; timing, damage and reaction are derived from the XV2 hit entry (tools/remake_samples.py, REMAKE-SAMPLES.md). Edit it in the Workbench.
# XV2 hit entry 320; limb foot.R
PUT ANIM_RATE 1.0
wait_until 2
GET ra_f:0 FACING
MUL ra_f:0 1.6
PUT GROUND_VEL ra_f:0
wait_until 9
GET ra_f:0 FACING
MUL ra_f:0 1.6
PUT GROUND_VEL ra_f:0
wait_until 14
hitbox slot=0 joint=@FOOT_R@ damage=8 size=2.8 x=-0.03949 y=-0.4019 z=0.8439 angle=361 kbg=50 fkb=0 bkb=12
hitbox slot=1 joint=@LEG_R@ damage=7 size=5.04 x=0.04702 y=-1.652 z=-0.1287 angle=361 kbg=50 fkb=0 bkb=9
hitbox slot=2 joint=@UPLEG_R@ damage=6 size=5.04 x=-0.1149 y=-1.493 z=-0.08663 angle=361 kbg=50 fkb=0 bkb=6
wait_until 16
PUT GROUND_VEL 0
wait_until 18
clear_hitboxes
wait_until 45
iasa
