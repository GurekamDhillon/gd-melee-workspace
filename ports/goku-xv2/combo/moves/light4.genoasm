# COMBO (geno 11): XV2 light string hit 4. Clip GOK_ATC_009 = BAC GOK_PLAYER 303 (BCM 0/18/3/3/3). BAC hit f12 dur 4.
# The step is held through the hit window (XV2's movement record ends at the hit frame; held 4 frames longer).
# Limb: foot.R reaches +10.47 Z, +3.47 Y at f12 (combo/limbs.py). String hit, as Light3.
PUT ANIM_RATE 1.0
# XV2 BAC Movement event f6 dur 6 (BAC 303); the step is GROUND_VEL x FACING, a design speed (the BAC record's speed is not decoded)
wait_until 6
GET ra_f:0 FACING
MUL ra_f:0 1.2
PUT GROUND_VEL ra_f:0
wait_until 9
GET ra_f:0 FACING
MUL ra_f:0 1.2
PUT GROUND_VEL ra_f:0
wait_until 12
hitbox slot=0 joint=@FOOT_R@ damage=4 size=3.6 x=0 y=0 z=0 angle=361 kbg=60 fkb=10 bkb=0
hitbox slot=1 joint=@CHEST@ damage=4 size=3.0 x=0 y=0 z=0 angle=361 kbg=60 fkb=10 bkb=0
HBSTUN 3 15
GET ra_f:0 FACING
MUL ra_f:0 1.2
PUT GROUND_VEL ra_f:0
wait_until 16
PUT GROUND_VEL 0
clear_hitboxes
wait_until 39
iasa
