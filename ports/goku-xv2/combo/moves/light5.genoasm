# HB-SAMPLE (remake phase 2, 2026-10-11): a generated STARTING POINT, not an authored hitbox. Spheres ride the leading limb chain (tip, middle, inner),
# sized from the mesh; timing, damage and reaction are derived from the XV2 hit entry (tools/remake_samples.py, REMAKE-SAMPLES.md). Edit it in the Workbench.
# XV2 hit entry 304; limb hand.L
PUT ANIM_RATE 1.0
wait_until 3
hitbox slot=0 joint=@ARM_L@ damage=7 size=1.4 x=2.802 y=-0.0331 z=0.04987 angle=361 kbg=60 fkb=10 bkb=0
hitbox slot=1 joint=@ARM_L@ damage=6 size=1.4 x=1.492 y=-0.05802 z=0.01413 angle=361 kbg=60 fkb=10 bkb=0
hitbox slot=2 joint=@UPARM_L@ damage=5 size=1.418 x=1.197 y=-0.09093 z=0.0736 angle=361 kbg=60 fkb=10 bkb=0
HBSTUN 7 10
wait_until 4
GET ra_f:0 FACING
MUL ra_f:0 1.4
PUT GROUND_VEL ra_f:0
wait_until 6
GET ra_f:0 FACING
MUL ra_f:0 1.4
PUT GROUND_VEL ra_f:0
wait_until 7
clear_hitboxes
wait_until 8
GET ra_f:0 FACING
MUL ra_f:0 1.4
PUT GROUND_VEL ra_f:0
wait_until 12
PUT GROUND_VEL 0
wait_until 31
iasa
