# This repo tracks only the port's build tooling, notes and research.
#
# The game and its references are their own upstream checkouts, and the build
# outputs are large and fully regenerable, so neither belongs here.

# Sibling checkouts, each its own repository.
/melee/
/dusklight/
/tp/
/nod/
/dawn/

# Prebuilt clang/LLVM: ~490 MB, unpacked from the tarball beside it.
/_toolchains/

# Build trees. ax86 exists only to download Dawn and SDL3 for ax86m to reuse.
/_build/ax86/
/_build/ax86m/
/_build/gwtool/
/_build/irtest/
/_build/masstest/out/
/_build/masstest/shimobj/
/_build/masstest/extra/

# Per-agent build roots and run sandboxes (tools/port/agent_new.sh, tools/port/run.sh):
# objects, an exe and a log per parallel worker, all regenerable.
/_build/agents/
/_build/runs/
/worktrees/

# Generated symbol audits: regenerate with the commands in docs/DEVLOG.md section 4.
/_build/masstest/*.txt
!/_build/masstest/files.txt

# Binaries and run artefacts.
*.exe
*.dll
*.pdb
*.map
*.log
*.obj
*.o
*.bin
*.lib
*.bc
*.ll

# Runtime state: live pad feed, memory-card saves, scratch objects.
pad_live.txt
_build/pad_live.txt
_build/card/

# Disc-modding artefacts: the built disc and its patch are regenerable from the
# user-supplied clean ISO (see docs/HANDOFF.md §3). Never commit either.
/akaneia-build/
/patch.xdelta

# Generated research dumps; regenerate locally with the commands in docs/DEVLOG.md.
/_research/scripts/_psdisp.i
/_research/scripts/common.txt
/_research/scripts/dl_*.txt
/_research/scripts/tp_*.txt

# OpenCode session state.
/.omo/

# Python bytecode.
__pycache__/
*.pyc
