 "sequences": {
  "list_cursor_move": [
   {
    "event": "row_deselect",
    "on": "previous"
   },
   {
    "event": "row_select",
    "on": "new"
   },
   {
    "event": "scroll",
    "when": "the new row is within one row of an edge"
   }
  ],
  "value_change": [
   {
    "event": "toggle_set | choice_step | slider_step | stepper_step",
    "on": "selected row",
    "when": "the value can change"
   },
   {
    "event": "bump",
    "on": "selected row",
    "when": "it cannot"
   }
  ],
  "dialog": [
   {
    "event": "dialog_open"
   },
   {
    "event": "button_select",
    "on": "default button"
   },
   {
    "event": "dialog_close",
    "when": "confirmed or cancelled"
   }
  ],
  "toast": [
   {
    "event": "toast_in"
   },
   {
    "hold_frames": 90
   },
   {
    "event": "toast_out"
   }
  ],
  "hold_repeat": {
   "delay_frames": 24,
   "interval_frames": 4
  }
 }
