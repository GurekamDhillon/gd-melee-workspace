 "sequences": {
  "start": [
   {
    "event": "dialog_open (kit)",
    "on": "connect_dialog"
   },
   {
    "event": "status_set",
    "on": "strip",
    "state": "working"
   },
   {
    "event": "activity_loop",
    "on": "strip + dialog"
   },
   {
    "event": "sweep_loop",
    "on": "strip + dialog"
   }
  ],
  "connected": [
   {
    "event": "status_set",
    "state": "connected"
   },
   {
    "event": "status_connected"
   },
   {
    "note": "dialog variant 'connected' for 30 frames, then the match"
   }
  ],
  "failed": [
   {
    "event": "status_set",
    "state": "failed"
   },
   {
    "event": "status_failed"
   },
   {
    "note": "dialog variant 'failed'; B closes it (kit dialog_close)"
   }
  ],
  "cancel": [
   {
    "event": "dialog_close (kit)"
   },
   {
    "event": "status_set",
    "state": "idle"
   }
  ],
  "copy": [
   {
    "event": "code_copied",
    "on": "your_code"
   },
   {
    "event": "toast_in (kit)",
    "text": "Code copied",
    "optional": true
   }
  ]
 }
}