+struct Snapshot { std::vector<Draw> draws;std::vector<Block> blocks;size_t bytes=0;bool failed=false;
+    std::vector<const Blob*> uniq_verts,uniq_indices,uniq_uniforms,uniq_static;size_t palette_bytes=0; };
