<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Xv2Fx</AssemblyName>
    <RootNamespace>Xv2Fx</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup>
    <XV2_LIB_DIR Condition="'$(XV2_LIB_DIR)' == ''">E:\Torrents\Dragon.Ball.Xenoverse.2.Future.Saga.Chapter.4-RUNE\modding\src\XV2-Tools\Xv2CoreLib\bin\Release\net10.0-windows</XV2_LIB_DIR>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Xv2CoreLib">
      <HintPath>$(XV2_LIB_DIR)\Xv2CoreLib.dll</HintPath>
    </Reference>
    <Reference Include="LB_Common">
      <HintPath>$(XV2_LIB_DIR)\LB_Common.dll</HintPath>
    </Reference>
    <Reference Include="YAXLib">
      <HintPath>$(XV2_LIB_DIR)\YAXLib.dll</HintPath>
    </Reference>
    <Reference Include="CSharpImageLibrary">
      <HintPath>$(XV2_LIB_DIR)\CSharpImageLibrary.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Transitive packages the Xv2CoreLib build used (same versions, from the NuGet cache). -->
    <PackageReference Include="FastCloner" Version="3.5.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MIConvexHull" Version="1.1.19.1019" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="1.2.2" />
    <PackageReference Include="Pfim" Version="0.11.3" />
    <PackageReference Include="SharpNoise" Version="0.12.1.1" />
    <PackageReference Include="WriteableBitmapEx" Version="1.6.11" />
  </ItemGroup>

</Project>
